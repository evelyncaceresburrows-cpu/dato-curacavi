# ─────────────────────────────────────────────────────────────
# Dato Curacaví · Variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# Las variables `VITE_*` se exponen al bundle (no incluir secretos).
# ─────────────────────────────────────────────────────────────

# Supabase (opcional — si faltan, la app usa la semilla local)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# URL pública del sitio (para canonicals, sitemap, OG tags)
VITE_SITE_URL=https://datocuracavi.cl

# Analytics privacy-friendly (Plausible / Umami / propio). Opcional.
# Si se deja vacío, los events solo se loggean en consola en dev.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_DOMAIN=datocuracavi.cl

# Feature flags
VITE_USE_HASH_ROUTER=false
VITE_ENABLE_MOBILE_PROTOTYPE=false
